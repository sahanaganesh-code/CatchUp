# Required: Google AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# Optional: API auth & rate limiting
# API_KEY=optional_api_key_for_X-API-Key_header
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60

# Optional: Google Meet webhook verification
# GOOGLE_MEET_WEBHOOK_SECRET=your_secret

# Optional: Google OAuth2 (Calendar, Gmail, Drive, Tasks, Docs, Slides)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CREDENTIALS_PATH=

# Optional: Google product IDs
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_TASKS_LIST_ID=

CHROMA_PERSIST_DIR=./chroma_db
