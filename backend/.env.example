GEMINI_API_KEY=your_gemini_api_key_here
# Google Cloud Speech-to-Text (primary STT): your GCP project ID
GOOGLE_CLOUD_PROJECT=niyati-cheesehacks
# Long audio (e.g. 60–120 min lectures): create a GCS bucket and set its name here (no ffmpeg needed)
# GOOGLE_CLOUD_STT_BUCKET=your-bucket-name
CHROMA_PERSIST_DIR=./chroma_db
# gemini-1.5-flash is not available on v1beta (404). Use 2.0-flash.
GEMINI_MODEL=gemini-2.0-flash
# Optional: fallback when primary hits quota
# GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# Embeddings: true = no Gemini for ingest/retrieval (keyword-only). Avoids quota. Set false to use Gemini embeddings.
EMBEDDINGS_USE_LOCAL=true
# Recap: set OPENAI_API_KEY to use OpenAI for recap (paraphrased, short bullets; avoids Gemini rate limits)
# OPENAI_API_KEY=sk-...
OPENAI_RECAP_MODEL=gpt-4o-mini
# Recap: true = local key points only (no API). false = OpenAI if key set, else Gemini
RECAP_USE_LOCAL=true
# Q&A: true = local retrieval + synthesis (no API). false = Gemini
QA_USE_LOCAL=true
# Local LLM (Ollama): recap + Q&A with no API keys, no rate limits
USE_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GOOGLE_APPLICATION_CREDENTIALS=backend/gcp-key.json