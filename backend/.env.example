GEMINI_API_KEY=your_gemini_api_key_here
# Neon (or any Postgres with the pgvector extension) connection string
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# Comma-separated list of allowed frontend origins (add your deployed Vercel URL here)
CORS_ORIGINS=http://localhost:3000
